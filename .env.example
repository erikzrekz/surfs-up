# Copy this to .env and fill in. .env is gitignored.

# --- Push notifications (recommended: set up first, 30 seconds) ---
# Pick any hard-to-guess string. Install the ntfy app on your phone, then
# subscribe to this exact topic name. Don't share publicly.
NTFY_TOPIC=rory-surf-alerts-ri-CHANGEME

# --- Email via AgentMail (optional) ---
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
ALERT_TO=eriksreks@gmail.com

# --- Local-run conveniences ---
# Set DRY_RUN=1 to skip sending notifications (still writes site/data.json).
DRY_RUN=

# --- Threshold overrides (optional; defaults live in scripts/rules.py) ---
# NOW_DPD_S_MIN=9.0
# NOW_WVHT_FT_MIN=3.0
# FC_PERIOD_S_MIN=9.0
